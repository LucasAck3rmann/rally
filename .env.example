# App
NODE_ENV=development
API_PORT=3333
WEB_URL=http://localhost:3000
# Base pública do site (metadados/OG da landing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API consumida pelo site (Server Components). No docker-compose o serviço
# `web` fala com o `api` pelo nome do serviço.
API_URL=http://localhost:3333/api/v1
# Base pública da API — é ela que entra nas URLs das fotos do seed.
API_PUBLIC_URL=http://localhost:3333

# Banco / cache
DATABASE_URL=postgresql://rally:rally@localhost:5432/rally?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# AWS (LocalStack no dev)
AWS_REGION=sa-east-1
AWS_ENDPOINT=http://localhost:4566
S3_BUCKET=rally-media
SES_FROM=no-reply@rally.local

# Pagamentos / mensageria
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
